# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cloud Run / Vertex AI: uses the attached service account (no new API key).
# Leave false in AI Studio when using its injected Gemini API key.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=c3-app-162
GOOGLE_CLOUD_LOCATION=global
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_BACKUP_TEXT_MODEL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Studio development only: file-backed shared conversation, never committed.
VITTY_DATA_DIR=.vitty-data
# Production: private GCS JSON files. Uses attached service account, no browser key.
# VITTY_STORAGE_BUCKET=c3-app-162-vitty-history
# Optional Studio backend override. Public app defaults to same-origin.
# VITE_VITTY_API_BASE=https://ux-preview---viet-y-ivo7erh2oq-as.a.run.app
# VITTY_ALLOWED_ORIGINS=https://ais-dev-o3rrywly7slgnm7urzsfge-823055115091.asia-southeast1.run.app,https://viet-y.ai.studio
